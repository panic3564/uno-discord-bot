    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.4.2"
  }
}
